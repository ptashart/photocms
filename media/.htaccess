<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(fail|tmp.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
